# 通义千问 DashScope
# 值通过 Qoder Sites Settings 界面填写，不要粘贴到对话或代码中
DASHSCOPE_API_KEY=

# Base URL 示例（请从你的百炼控制台原样复制）：
# https://dashscope.aliyuncs.com/compatible-mode/v1
# 或区域专属域名（如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1）
DASHSCOPE_BASE_URL=

# 模型名称（如 qwen-plus、qwen-max、qwen-turbo 等）
DASHSCOPE_MODEL=
